# Скопируйте в .env и заполните. Сам .env в git не попадает.

RELAY_CONFIG=relay.toml
DATABASE_PATH=data/relay.db

# Секреты входящих вебхуков (имена — из secret_env в relay.toml)
STRIPE_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
FORM_WEBHOOK_SECRET=
# Секреты для подписи того, что мы доставляем (необязательно)
CRM_RELAY_SECRET=
LEADS_RELAY_SECRET=

# Ключ админ-API (/admin/…). Пусто — админ-API выключен. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=

HOST=127.0.0.1
PORT=8095

# Доставка: попыток, пауза перед повтором (удваивается), потолок паузы, таймаут, параллельность
MAX_ATTEMPTS=8
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=3600
DELIVERY_TIMEOUT=10
CONCURRENCY=4
# Сколько дней хранить успешно доставленные события (недоставленные хранятся, пока их не разберут)
RETENTION_DAYS=30
MAX_BODY_BYTES=1000000
